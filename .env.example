# ---- Docker Compose (root) ----
# Copy to .env and adjust. Do NOT commit .env.
POSTGRES_DB=caseclosed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# ---- Backend (apps/api) ----
# Local dev DATABASE_URL (host -> Docker postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/caseclosed
# Inside Compose, DATABASE_URL is overridden to use the postgres service host.

# TigerGraph (external Savanna Cloud or CE)
TIGERGRAPH_HOST=
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_GRAPHNAME=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROK_API_KEY=

# Vector store (pgvector in PostgreSQL)
VECTOR_STORE_URL=

# ---- Frontend (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
